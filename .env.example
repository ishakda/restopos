# SQLite by default (file path is relative to the prisma/ directory).
# For PostgreSQL in production see docs/DEPLOYMENT.md.
DATABASE_URL="file:./dev.db"

# 64+ hex chars. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-real-secret"

# Public URL of the app (used for absolute links)
APP_URL="http://localhost:3000"
