    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "latest",
    "next": "15.3.3",
    "next-intl": "^4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.3",
    "server-only": "^0.0.1",
